{
  "name": "tma-family-office-ios",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "VITE_BASE_PATH=/TMA-Family-Office-iOS/ tsc -b && VITE_BASE_PATH=/TMA-Family-Office-iOS/ vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.vitest.json",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:architecture": "node scripts/check-architecture.mjs",
    "quality": "npm run typecheck && npm run lint && npm run test:run && npm run test:architecture && npm run build && npm run build:pages"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "lucide-react": "^1.44.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
